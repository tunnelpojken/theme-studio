<?xml version="1.0" encoding="utf-8"?>
<!-- Theme Studio as an MSIX package for the Microsoft Store.
     build-msix.ps1 fills in the @...@ values from identity.json and the app version.

     Theme Studio's job is changing the user's own Windows settings (HKCU accent and mode,
     the wallpaper, Windows Terminal's settings.json). A packaged app normally writes HKCU
     and AppData into a private copy that Windows never reads, so registry and file-system
     write virtualization are turned off. That needs the restricted capability
     unvirtualizedResources, which the Store reviews by hand. -->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap6="http://schemas.microsoft.com/appx/manifest/uap/windows10/6"
  xmlns:desktop6="http://schemas.microsoft.com/appx/manifest/desktop/windows10/6"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap6 desktop6 rescap">

  <Identity Name="@NAME@" Publisher="@PUBLISHER@" Version="@VERSION@" ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>@DISPLAY_NAME@</DisplayName>
    <PublisherDisplayName>@PUBLISHER_DISPLAY_NAME@</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
    <desktop6:RegistryWriteVirtualization>disabled</desktop6:RegistryWriteVirtualization>
    <desktop6:FileSystemWriteVirtualization>disabled</desktop6:FileSystemWriteVirtualization>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Applications>
    <Application Id="ThemeStudio" Executable="Theme Studio.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="@DISPLAY_NAME@"
        Description="Make and apply desktop themes from a wallpaper or a short description."
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png"
                         Square310x310Logo="Assets\Square310x310Logo.png" />
      </uap:VisualElements>
    </Application>

    <!-- No command line in the Store package: an app without a Start entry counts as
         "headless", which the Store refuses. theme-studio.exe still ships in the folder;
         the GitHub installer and pipx give the command line. -->
  </Applications>

  <!-- A packaged app doesn't search PATH or the directories Python adds for DLLs, so Qt's
       plugins (qml\QtQuick\Controls\Basic\*.dll) couldn't find Qt6*.dll next to PySide6.
       These folders are searched for every DLL the app loads. -->
  <Extensions>
    <uap6:Extension Category="windows.loaderSearchPathOverride">
      <uap6:LoaderSearchPathOverride>
        <uap6:LoaderSearchPathEntry FolderPath="_internal\PySide6" />
        <uap6:LoaderSearchPathEntry FolderPath="_internal\shiboken6" />
        <uap6:LoaderSearchPathEntry FolderPath="_internal" />
      </uap6:LoaderSearchPathOverride>
    </uap6:Extension>
  </Extensions>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
    <rescap:Capability Name="unvirtualizedResources" />
  </Capabilities>
</Package>
